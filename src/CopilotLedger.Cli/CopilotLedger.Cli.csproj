<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>gh-ledger</AssemblyName>
    <RootNamespace>CopilotLedger.Cli</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.5.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CopilotLedger.Mcp\CopilotLedger.Mcp.csproj" />
    <ProjectReference Include="..\CopilotLedger.Otlp\CopilotLedger.Otlp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Export\Assets\report.css" LogicalName="CopilotLedger.Cli.Export.Assets.report.css" />
    <EmbeddedResource Include="Export\Assets\report.js" LogicalName="CopilotLedger.Cli.Export.Assets.report.js" />
  </ItemGroup>
</Project>
